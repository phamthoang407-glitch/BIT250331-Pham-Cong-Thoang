<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cyber Quiz 4.0 - An toàn thông tin</title>
  <style>
    :root{
      --bg:#07111f;--bg2:#0d1b2f;--card:rgba(255,255,255,.09);--card2:rgba(255,255,255,.13);
      --text:#f3fbff;--muted:#b8c7d9;--primary:#00e5ff;--secondary:#8b5cf6;--accent:#ff3df2;
      --good:#28e98f;--bad:#ff5577;--warn:#ffd166;--line:rgba(255,255,255,.16);--shadow:0 22px 70px rgba(0,0,0,.35);
    }
    body.light{--bg:#eef7ff;--bg2:#fff;--card:rgba(255,255,255,.78);--card2:#fff;--text:#0a1930;--muted:#526174;--line:rgba(10,25,48,.13);--shadow:0 22px 60px rgba(20,60,120,.14)}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;background:radial-gradient(circle at top left,rgba(0,229,255,.22),transparent 32%),radial-gradient(circle at top right,rgba(139,92,246,.25),transparent 35%),linear-gradient(135deg,var(--bg),var(--bg2));color:var(--text);min-height:100vh;overflow-x:hidden}
    canvas#matrix{position:fixed;inset:0;z-index:-3;opacity:.22}.orb{position:fixed;border-radius:999px;filter:blur(50px);opacity:.45;z-index:-2}.orb.one{width:330px;height:330px;background:var(--primary);top:12%;left:-90px}.orb.two{width:400px;height:400px;background:var(--secondary);right:-120px;bottom:8%}.app{width:min(1180px,94%);margin:0 auto;padding:22px 0 80px}.topbar{position:sticky;top:14px;z-index:20;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px;border:1px solid var(--line);background:rgba(7,17,31,.62);backdrop-filter:blur(18px);border-radius:24px;box-shadow:var(--shadow)}body.light .topbar{background:rgba(255,255,255,.72)}.brand{display:flex;align-items:center;gap:10px;font-weight:900}.logo{width:42px;height:42px;border-radius:15px;display:grid;place-items:center;background:linear-gradient(135deg,var(--primary),var(--secondary));box-shadow:0 0 28px rgba(0,229,255,.45)}.nav{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.btn{border:0;border-radius:16px;padding:11px 15px;font-weight:800;color:var(--text);background:linear-gradient(135deg,rgba(0,229,255,.18),rgba(139,92,246,.2));border:1px solid var(--line);cursor:pointer;transition:.2s;position:relative;overflow:hidden}.btn:before{content:"";position:absolute;inset:-40% auto -40% -70%;width:50%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.5),transparent);transform:rotate(25deg);transition:.5s}.btn:hover{transform:translateY(-2px);box-shadow:0 14px 35px rgba(0,229,255,.18)}.btn:hover:before{left:125%}.btn.primary{background:linear-gradient(135deg,var(--primary),var(--secondary));color:#03101f}.btn.danger{background:linear-gradient(135deg,var(--bad),#ff8fab);color:white}.hero{padding:70px 0 42px;display:grid;grid-template-columns:1.25fr .75fr;align-items:center;gap:26px}.badge{display:inline-flex;gap:8px;align-items:center;padding:9px 13px;border:1px solid var(--line);border-radius:999px;background:var(--card);color:var(--muted);font-weight:800}.hero h1{font-size:clamp(38px,7vw,82px);line-height:.98;margin:18px 0;background:linear-gradient(90deg,var(--primary),#fff,var(--accent));-webkit-background-clip:text;background-clip:text;color:transparent}.hero p{font-size:18px;color:var(--muted);max-width:720px;line-height:1.65}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}.shield{min-height:310px;border-radius:36px;background:linear-gradient(145deg,rgba(0,229,255,.16),rgba(139,92,246,.18));border:1px solid var(--line);display:grid;place-items:center;box-shadow:var(--shadow);position:relative;overflow:hidden}.shield:after{content:"";position:absolute;width:230px;height:230px;border-radius:50%;background:rgba(255,255,255,.08);filter:blur(10px);animation:float 5s infinite ease-in-out}.shield-icon{font-size:116px;filter:drop-shadow(0 0 22px rgba(0,229,255,.55));animation:float 4s infinite ease-in-out;z-index:1}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:28px}.stat,.card{background:var(--card);border:1px solid var(--line);border-radius:24px;padding:18px;box-shadow:var(--shadow);backdrop-filter:blur(16px)}.stat b{display:block;font-size:28px;color:var(--primary)}.section{display:none;animation:fade .25s ease}.section.active{display:block}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px}.topic{cursor:pointer;min-height:180px;transition:.2s;position:relative;overflow:hidden}.topic:hover{transform:translateY(-6px) scale(1.01);box-shadow:0 24px 70px rgba(0,229,255,.2)}.topic:before{content:"";position:absolute;inset:0;background:linear-gradient(135deg,rgba(0,229,255,.1),rgba(255,61,242,.08));opacity:0;transition:.2s}.topic:hover:before{opacity:1}.topic .icon{font-size:42px}.topic h3{font-size:22px;margin:14px 0 8px}.muted{color:var(--muted)}.quiz-head{display:flex;justify-content:space-between;gap:12px;align-items:center;margin:18px 0}.progress{height:14px;background:rgba(255,255,255,.12);border-radius:999px;overflow:hidden}.bar{height:100%;width:0;background:linear-gradient(90deg,var(--primary),var(--accent));transition:.3s}.question{font-size:26px;font-weight:900;margin:14px 0 22px}.answers{display:grid;gap:12px}.answer{padding:16px;border-radius:18px;border:1px solid var(--line);background:var(--card);cursor:pointer;text-align:left;color:var(--text);font-weight:750;transition:.16s}.answer:hover{transform:translateX(4px);background:var(--card2)}.answer.correct{background:rgba(40,233,143,.22);border-color:var(--good)}.answer.wrong{background:rgba(255,85,119,.22);border-color:var(--bad)}.feedback{margin-top:16px;padding:16px;border-radius:18px;background:rgba(255,255,255,.08);border:1px solid var(--line);display:none}.feedback.show{display:block}.source{margin-top:8px;color:var(--warn);font-weight:800}.result{text-align:center;padding:36px}.result .score{font-size:70px;font-weight:1000;background:linear-gradient(90deg,var(--primary),var(--accent));-webkit-background-clip:text;color:transparent}.form{display:grid;gap:12px}.input,select,textarea{width:100%;border:1px solid var(--line);border-radius:16px;padding:13px 14px;background:rgba(255,255,255,.09);color:var(--text);outline:none}option{color:#111}textarea{min-height:90px;resize:vertical}.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.qitem{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;margin-top:12px;padding:14px;border:1px solid var(--line);border-radius:18px;background:rgba(255,255,255,.06)}.chat-btn{position:fixed;right:22px;bottom:22px;width:66px;height:66px;border-radius:50%;z-index:30;border:0;background:linear-gradient(135deg,var(--primary),var(--accent));font-size:27px;cursor:pointer;box-shadow:0 0 0 0 rgba(0,229,255,.6);animation:pulse 2s infinite}.chat{position:fixed;right:22px;bottom:98px;width:min(390px,92vw);height:520px;z-index:31;background:rgba(7,17,31,.92);border:1px solid var(--line);border-radius:24px;box-shadow:var(--shadow);display:none;overflow:hidden;backdrop-filter:blur(18px)}body.light .chat{background:rgba(255,255,255,.94)}.chat.open{display:flex;flex-direction:column}.chat-header{padding:16px;background:linear-gradient(135deg,rgba(0,229,255,.18),rgba(139,92,246,.2));font-weight:900;display:flex;justify-content:space-between}.chat-body{flex:1;overflow:auto;padding:14px;display:flex;flex-direction:column;gap:10px}.msg{max-width:86%;padding:11px 13px;border-radius:16px;background:var(--card);line-height:1.45}.msg.user{align-self:flex-end;background:linear-gradient(135deg,var(--primary),var(--secondary));color:#03101f;font-weight:800}.chat-input{display:flex;gap:8px;padding:12px;border-top:1px solid var(--line)}.chat-input input{flex:1}.hidden{display:none!important}@keyframes fade{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}@keyframes float{50%{transform:translateY(-15px) rotate(4deg)}}@keyframes pulse{70%{box-shadow:0 0 0 18px rgba(0,229,255,0)}}@media(max-width:800px){.hero{grid-template-columns:1fr}.shield{min-height:230px}.stats{grid-template-columns:1fr}.row{grid-template-columns:1fr}.topbar{align-items:flex-start;flex-direction:column}.nav{justify-content:flex-start}.quiz-head{flex-direction:column;align-items:flex-start}}
  </style>
</head>
<body>
  <canvas id="matrix"></canvas><div class="orb one"></div><div class="orb two"></div>
  <div class="app">
    <header class="topbar"><div class="brand"><div class="logo">🛡️</div><div>Cyber Quiz 4.0<br><span class="muted" style="font-size:12px">An toàn thông tin</span></div></div><nav class="nav"><button class="btn" onclick="showSection('home')">Trang chủ</button><button class="btn" onclick="showSection('topics')">Chủ đề</button><button class="btn" onclick="showSection('manage')">➕ Quản lý câu hỏi</button><button class="btn" onclick="showSection('rank')">🏆 Xếp hạng</button><button class="btn" onclick="toggleTheme()">🌗 Giao diện</button></nav></header>

    <section id="home" class="section active"><div class="hero"><div><span class="badge">🚀 Học bảo mật kiểu game hóa</span><h1>Trở thành chiến binh an toàn thông tin</h1><p>Trả lời câu hỏi, nhận mẹo bảo mật, xem nguồn tham khảo và trò chuyện với trợ lý AI ngoại tuyến.</p><div class="hero-actions"><button class="btn primary" onclick="showSection('topics')">Bắt đầu ngay</button><button class="btn" onclick="openChat()">Hỏi trợ lý AI</button></div><div class="stats"><div class="stat"><b id="statQ">0</b>Câu hỏi</div><div class="stat"><b>8</b>Chủ đề</div><div class="stat"><b>100%</b>Miễn phí</div></div></div><div class="shield"><div class="shield-icon">🛡️</div></div></div></section>

    <section id="topics" class="section"><h2>🎯 Chọn chủ đề</h2><p class="muted">Mỗi lượt gồm tối đa 10 câu. Câu bạn thêm sẽ tự động được gộp vào đúng chủ đề.</p><div id="topicsGrid" class="grid"></div></section>

    <section id="quiz" class="section"><div class="quiz-head"><button class="btn" onclick="showSection('topics')">← Chủ đề</button><div><b id="quizTitle"></b><div class="muted" id="quizCount"></div></div><div>Điểm: <b id="scoreText">0</b></div></div><div class="progress"><div class="bar" id="progressBar"></div></div><div class="card" style="margin-top:18px"><div class="question" id="questionText"></div><div class="answers" id="answersBox"></div><div class="feedback" id="feedback"></div><button class="btn primary hidden" id="nextBtn" onclick="nextQuestion()" style="margin-top:14px">Câu tiếp theo</button></div></section>

    <section id="result" class="section"><div class="card result"><h2>🎉 Hoàn thành!</h2><div class="score" id="finalScore">0%</div><p id="resultMsg" class="muted"></p><button class="btn primary" onclick="showSection('topics')">Làm chủ đề khác</button></div></section>

    <section id="manage" class="section"><h2>⚙️ Quản lý câu hỏi</h2><div class="grid"><div class="card"><h3>➕ Thêm câu hỏi</h3><form id="qForm" class="form"><select id="qTopic" required></select><textarea id="qText" placeholder="Nhập câu hỏi" required></textarea><div class="row"><input class="input" id="a0" placeholder="Đáp án A" required><input class="input" id="a1" placeholder="Đáp án B" required></div><div class="row"><input class="input" id="a2" placeholder="Đáp án C" required><input class="input" id="a3" placeholder="Đáp án D" required></div><select id="correct" required><option value="0">A là đáp án đúng</option><option value="1">B là đáp án đúng</option><option value="2">C là đáp án đúng</option><option value="3">D là đáp án đúng</option></select><textarea id="tip" placeholder="Mẹo / giải thích" required></textarea><input class="input" id="source" placeholder="Nguồn tham khảo" required><button class="btn primary">Lưu câu hỏi</button></form></div><div class="card"><h3>📋 Toàn bộ câu hỏi</h3><button class="btn" onclick="restoreDeleted()">♻️ Khôi phục câu hỏi gốc đã xóa</button><div id="questionList"></div></div></div></section>

    <section id="rank" class="section"><h2>🏆 Bảng xếp hạng gần đây</h2><div id="rankList" class="card"></div></section>
  </div>

  <button class="chat-btn" onclick="toggleChat()">💬</button><div id="chat" class="chat"><div class="chat-header">🤖 Trợ lý An toàn thông tin <button class="btn" onclick="toggleChat()">×</button></div><div id="chatBody" class="chat-body"><div class="msg">Chào bạn! Mình có thể giải thích về phishing, mật khẩu mạnh, 2FA, ransomware, Wi‑Fi công cộng...</div></div><div class="chat-input"><input class="input" id="chatInput" placeholder="Nhập câu hỏi..." onkeydown="if(event.key==='Enter')sendChat()"><button class="btn primary" onclick="sendChat()">➤</button></div></div>

  <script>
    const topics=[['password','🔐','Mật khẩu & 2FA'],['phishing','🎣','Lừa đảo Phishing'],['malware','🦠','Mã độc'],['privacy','🕵️','Quyền riêng tư'],['wifi','📶','Wi‑Fi & mạng'],['social','👥','Mạng xã hội'],['law','⚖️','Pháp luật dữ liệu'],['safe','🧠','Thói quen an toàn']];
    const src={password:'NIST Digital Identity Guidelines, CISA',phishing:'CISA Phishing Guidance, NCSC',malware:'CISA Malware Basics, NCSC',privacy:'Nghị định 13/2023/NĐ-CP, Cục ATTT',wifi:'CISA, NCSC',social:'Cục An toàn thông tin - Bộ TT&TT',law:'Nghị định 13/2023/NĐ-CP',safe:'NCSC, CISA'};
    const baseQuestions=[
      q('password','Mật khẩu nào dưới đây an toàn nhất?',['12345678','abc123','Trung1936','T@8r#Q9Lp2!'],3,'Mật khẩu mạnh nên dài, khó đoán và kết hợp chữ hoa, chữ thường, số và ký tự đặc biệt.'),

      q('password','Bạn nên làm gì nếu sử dụng nhiều tài khoản khác nhau?',['Dùng cùng một mật khẩu cho tất cả','Mỗi tài khoản nên có mật khẩu riêng','Chỉ đổi mật khẩu Facebook','Ghi tất cả mật khẩu lên giấy dán màn hình'],1,'Nếu một tài khoản bị lộ, việc dùng chung mật khẩu sẽ khiến các tài khoản khác cũng gặp nguy hiểm.'),
      q('password','Bạn nhận được mã OTP nhưng không hề đăng nhập tài khoản. Bạn nên làm gì?',['Gửi mã cho người gọi điện xin hỗ trợ','Bỏ qua và tuyệt đối không chia sẻ mã OTP','Đăng lên Facebook hỏi','Gửi cho bạn bè kiểm tra'],1,'OTP là mã dùng một lần để xác minh tài khoản. Không chia sẻ cho bất kỳ ai.'),

      q('password','Xác thực hai yếu tố (2FA) giúp ích gì?',['Tăng tốc Internet','Thêm một lớp bảo vệ khi đăng nhập','Làm điện thoại chạy nhanh hơn','Tăng dung lượng lưu trữ'],1,'Ngay cả khi mật khẩu bị lộ, kẻ gian vẫn cần thêm mã xác thực mới có thể đăng nhập.'),

      q('password','Ai là người được phép biết mã OTP của bạn?',['Nhân viên ngân hàng','Công an','Chỉ chính bạn','Bạn bè thân'],2,'Không có ngân hàng hay cơ quan nhà nước nào yêu cầu khách hàng đọc mã OTP qua điện thoại.'),

      q('password','Nếu một website yêu cầu bạn nhập mật khẩu tài khoản Google nhưng địa chỉ trang web có dấu hiệu lạ, bạn nên làm gì?',['Đăng nhập ngay','Kiểm tra kỹ địa chỉ website, nếu nghi ngờ thì không đăng nhập','Đổi sang dùng Facebook','Nhờ người khác đăng nhập hộ'],1,'Đây có thể là website giả mạo nhằm đánh cắp tài khoản.'),

      q('password','Sau khi đổi mật khẩu tài khoản, bạn nên làm gì?',['Đăng xuất khỏi các thiết bị không còn sử dụng','Không cần làm gì','Chia sẻ mật khẩu mới cho bạn bè','Tắt Wi-Fi'],0,'Đăng xuất khỏi các thiết bị cũ giúp hạn chế người khác tiếp tục truy cập tài khoản.'),

      q('password','Khi nhận được cuộc gọi tự xưng là nhân viên ngân hàng yêu cầu đọc mã OTP để "xác minh tài khoản", bạn nên làm gì?',['Đọc ngay','Từ chối và kết thúc cuộc gọi','Đọc một phần mã','Gửi mã qua tin nhắn'],1,'OTP chỉ dùng để xác thực cho chính bạn, không cung cấp cho bất kỳ ai.'),

      q('password','Nếu điện thoại bị mất, tính năng nào giúp giảm nguy cơ người khác đăng nhập tài khoản của bạn?',['Xác thực hai yếu tố (2FA)','Diệt virus','Giảm độ sáng màn hình','Xóa lịch sử trình duyệt'],0,'2FA yêu cầu thêm bước xác minh khi đăng nhập, giúp tăng cường bảo mật.'),

      q('password','Thói quen nào dưới đây giúp bảo vệ tài khoản tốt nhất?',['Đặt mật khẩu mạnh và bật xác thực hai yếu tố (2FA)','Dùng chung một mật khẩu cho mọi tài khoản','Lưu mật khẩu ở nơi công cộng','Chia sẻ mật khẩu cho người thân để phòng quên'],0,'Kết hợp mật khẩu mạnh với xác thực hai yếu tố là một trong những cách hiệu quả nhất để bảo vệ tài khoản.'),

      q('password','Bạn nhận được email thông báo: "Có người vừa đăng nhập vào tài khoản của bạn từ một thiết bị lạ." Bạn nên làm gì trước tiên?',['Bỏ qua vì có thể là lỗi hệ thống','Đổi mật khẩu ngay và kiểm tra hoạt động đăng nhập gần đây','Xóa email','Tắt Wi-Fi'],1,'Nếu phát hiện hoạt động đăng nhập bất thường, hãy đổi mật khẩu ngay và kiểm tra các thiết bị đã đăng nhập.'),

      q('password','Khi bật xác thực hai yếu tố (2FA), nếu ai đó biết mật khẩu của bạn thì điều gì sẽ xảy ra?',['Họ đăng nhập được ngay','Họ vẫn cần bước xác minh thứ hai để đăng nhập','Họ có thể đổi mật khẩu ngay','Tài khoản sẽ tự động bị khóa'],1,'2FA bổ sung thêm một lớp bảo vệ. Dù mật khẩu bị lộ, kẻ gian vẫn cần mã xác minh hoặc thiết bị xác thực của bạn.'),

      q('password','Khi sử dụng xác thực hai yếu tố (2FA), bạn nên lưu mã khôi phục (Backup Codes) ở đâu?',['Đăng lên Facebook để dễ tìm','Gửi vào nhóm chat','Lưu ở nơi an toàn, chỉ mình bạn biết','Không cần lưu'],2,'Mã khôi phục giúp bạn lấy lại quyền truy cập khi mất điện thoại. Vì vậy cần lưu ở nơi an toàn và tuyệt đối không chia sẻ.'),

      q('password','Đâu là thói quen KHÔNG nên làm khi đặt mật khẩu?',['Dùng ngày sinh của mình','Kết hợp chữ hoa, chữ thường, số và ký tự đặc biệt','Đặt mật khẩu dài','Mỗi tài khoản có một mật khẩu riêng'],0,'Ngày sinh và các thông tin cá nhân rất dễ bị đoán. Hãy tạo mật khẩu dài và khó đoán.'),

      q('password','Nếu nhận được mã xác minh (OTP/Verification Code) nhưng bạn không hề đăng nhập tài khoản, bạn nên làm gì?',['Cung cấp mã cho người gọi tự xưng là nhân viên hỗ trợ','Bỏ qua mã và đổi mật khẩu nếu nghi ngờ tài khoản bị lộ','Đăng mã lên mạng xã hội để hỏi','Chuyển tiếp mã cho bạn bè'],1,'Nếu nhận được mã khi không thực hiện đăng nhập, có thể ai đó đang cố truy cập tài khoản của bạn. Tuyệt đối không chia sẻ mã xác minh.'),
      q('phishing','Bạn nhận được email từ "Ngân hàng ABC" thông báo tài khoản sắp bị khóa và yêu cầu nhấn vào một liên kết để đăng nhập xác minh. Bạn nên làm gì?',['Nhấn vào liên kết và đăng nhập ngay','Gọi theo số điện thoại trong email','Không nhấn vào liên kết, truy cập website hoặc ứng dụng chính thức của ngân hàng để kiểm tra','Chuyển tiếp email cho bạn bè'],2,'Đây là thủ đoạn phishing phổ biến. Kẻ gian gửi email giả mạo để dụ người dùng nhập tên đăng nhập và mật khẩu trên website giả.'),

      q('phishing','Khi kiểm tra một website đăng nhập, dấu hiệu nào dưới đây cần khiến bạn cảnh giác?',['Tên miền có thêm ký tự lạ hoặc viết sai chính tả','Website có logo đẹp','Website có nhiều hình ảnh','Website tải nhanh'],0,'Website phishing thường dùng tên miền rất giống trang thật nhưng thay đổi một vài ký tự để đánh lừa người dùng.'),

      q('phishing','Một người nhắn tin cho bạn qua Facebook và gửi đường link nhận quà miễn phí. Bạn nên làm gì?',['Nhấn ngay để nhận quà','Đăng nhập tài khoản theo yêu cầu','Không nhấn vào liên kết lạ và xác minh thông tin từ nguồn chính thức','Chia sẻ đường link cho bạn bè'],2,'Các liên kết nhận quà hoặc trúng thưởng thường dẫn tới trang phishing nhằm đánh cắp tài khoản hoặc thông tin cá nhân.'),

      q('phishing','Bạn nhận được tin nhắn yêu cầu đổi mật khẩu ngay bằng cách truy cập vào một đường link lạ. Bạn nên làm gì?',['Đổi mật khẩu theo đường link','Truy cập trực tiếp website hoặc ứng dụng chính thức để kiểm tra','Gửi đường link cho người thân','Bỏ qua mọi cảnh báo bảo mật'],1,'Không nên đổi mật khẩu thông qua các liên kết trong email hoặc tin nhắn không xác minh được.'),

      q('phishing','Nếu nghi ngờ một website là giả mạo, bạn nên làm gì trước khi nhập thông tin cá nhân?',['Nhập thử xem có đúng không','Tra cứu tên miền trên hệ thống kiểm tra website lừa đảo được Bộ Công an hướng dẫn','Tắt trình duyệt','Đổi sang trình duyệt khác rồi nhập'],1,'Nên kiểm tra tên miền trước khi đăng nhập hoặc nhập thông tin cá nhân.'),

      q('phishing','Bạn nhận được tin nhắn SMS thông báo trúng thưởng và yêu cầu đăng nhập tài khoản để nhận quà. Bạn nên làm gì?',['Đăng nhập ngay để nhận thưởng','Không nhấn vào liên kết, kiểm tra thông tin trên website chính thức của đơn vị','Gửi tin nhắn cho bạn bè','Nhập thông tin cá nhân để xác minh'],1,'Đây là thủ đoạn phishing phổ biến nhằm đánh cắp tài khoản và thông tin cá nhân.'),

      q('phishing','Khi đăng nhập tài khoản ngân hàng trên website, điều nào dưới đây cần kiểm tra trước?',['Website có nhiều hình ảnh','Đúng tên miền chính thức của ngân hàng','Website tải nhanh','Có nhiều quảng cáo'],1,'Website giả mạo thường có tên miền gần giống với website thật để đánh lừa người dùng.'),

      q('phishing','Một website yêu cầu nhập số CCCD, mật khẩu ngân hàng và mã OTP cùng lúc. Bạn nên làm gì?',['Cung cấp đầy đủ thông tin','Chỉ nhập CCCD','Dừng lại ngay và rời khỏi website','Chỉ nhập OTP'],2,'Ngân hàng và cơ quan nhà nước không yêu cầu người dân nhập đồng thời các thông tin này trên một website lạ.'),

      q('phishing','Bạn nhận được email yêu cầu cập nhật thông tin tài khoản trong vòng 24 giờ, nếu không sẽ bị khóa. Bạn nên làm gì?',['Làm theo ngay','Truy cập trực tiếp website hoặc ứng dụng chính thức để kiểm tra','Chuyển tiếp email','Gọi số điện thoại ghi trong email'],1,'Phishing thường tạo cảm giác khẩn cấp để khiến nạn nhân mất cảnh giác.'),

      q('phishing','Khi phát hiện website có giao diện giống hệt trang của Bộ Công an nhưng tên miền khác lạ, bạn nên làm gì?',['Truy cập bình thường','Không nhập thông tin và thoát khỏi website','Đăng nhập thử','Chia sẻ cho bạn bè'],1,'Kẻ gian thường sao chép giao diện website chính thức nhưng sử dụng tên miền khác để lừa người dùng.'),

      q('phishing','Nếu nghi ngờ đường link trong email là giả mạo, bạn nên làm gì?',['Nhấn thử xem nội dung','Kiểm tra đường dẫn hoặc truy cập trực tiếp website chính thức','Gửi cho bạn bè','Tắt máy tính'],1,'Không nên truy cập trực tiếp từ liên kết đáng ngờ mà hãy tự nhập địa chỉ website chính thức.'),

      q('phishing','Website nào dưới đây đáng tin cậy hơn?',['www.facebo0k-login.com','facebook-login.xyz','https://www.facebook.com','facebook.security-free.net'],2,'Tên miền chính thức thuộc sở hữu của dịch vụ luôn đáng tin cậy hơn các tên miền bắt chước.'),

      q('phishing','Trước khi nhập tài khoản và mật khẩu vào một website, bạn nên làm gì?',['Kiểm tra đúng tên miền của website','Kiểm tra màu sắc website','Kiểm tra số lượng hình ảnh','Kiểm tra tốc độ tải trang'],0,'Tên miền là một trong những dấu hiệu quan trọng giúp nhận biết website thật hay giả.'),

      q('phishing','Công cụ nào được Bộ Công an hướng dẫn sử dụng để kiểm tra website nghi lừa đảo?',['Google Maps','tinnhiemmang.vn','YouTube','Google Drive'],1,'Có thể sử dụng tinnhiemmang.vn để tra cứu website hoặc tên miền có dấu hiệu lừa đảo.'),

      q('phishing','Mục đích chính của các cuộc tấn công phishing là gì?',['Tăng tốc độ Internet','Đánh cắp thông tin đăng nhập, dữ liệu cá nhân hoặc tiền của nạn nhân','Làm điện thoại hết pin','Cập nhật phần mềm miễn phí'],1,'Phishing là hình thức giả mạo nhằm đánh cắp tài khoản, mật khẩu, OTP hoặc thông tin ngân hàng để chiếm đoạt tài sản.'),
      q('malware','Bạn nhận được cuộc gọi tự xưng là cán bộ Công an, yêu cầu cài ứng dụng VNeID qua một đường link gửi qua Zalo để cập nhật thông tin. Bạn nên làm gì?',['Cài đặt ngay theo hướng dẫn','Chỉ cài ứng dụng VNeID từ CH Play hoặc App Store chính thức','Gửi đường link cho bạn bè cùng cài','Tắt Wi-Fi rồi cài lại'],1,'Chỉ tải VNeID từ CH Play hoặc App Store chính thức để tránh ứng dụng giả mạo chứa mã độc.'),

      q('malware','Bạn nhận được tin nhắn có nội dung: "Nhấn vào đây để nhận quà miễn phí" kèm theo một đường link lạ. Bạn nên làm gì?',['Nhấn vào ngay để không bỏ lỡ','Chỉ nhấn nếu có nhiều người chia sẻ','Không nhấn vào đường link lạ và xóa tin nhắn','Gửi tiếp cho người thân'],2,'Đường link lạ có thể dẫn đến website chứa mã độc hoặc trang giả mạo nhằm đánh cắp thông tin cá nhân.'),

      q('malware','Bạn muốn cài một ứng dụng nhưng chỉ tìm thấy file APK trên một website lạ. Bạn nên làm gì?',['Tải và cài ngay','Chỉ cài ứng dụng từ CH Play hoặc App Store','Tắt phần mềm diệt virus rồi cài','Nhờ bạn bè cài hộ'],1,'Ứng dụng từ nguồn không chính thức có thể chứa mã độc và gây mất an toàn cho thiết bị.'),

      q('malware','Dấu hiệu nào dưới đây có thể cho thấy điện thoại đã bị nhiễm mã độc?',['Pin tụt nhanh bất thường, máy nóng và xuất hiện nhiều quảng cáo lạ','Chuông điện thoại kêu to hơn','Màn hình sáng hơn bình thường','Sóng Wi-Fi mạnh hơn'],0,'Mã độc thường chạy ngầm làm hao pin, nóng máy, xuất hiện quảng cáo hoặc tự động gửi dữ liệu.'),

      q('malware','Nếu lỡ cài một ứng dụng nghi chứa mã độc, bạn nên làm gì trước tiên?',['Tiếp tục sử dụng bình thường','Gỡ ứng dụng, ngắt kết nối mạng và liên hệ ngân hàng nếu đã đăng nhập tài khoản tài chính','Chia sẻ ứng dụng cho bạn bè để kiểm tra','Khởi động lại điện thoại là đủ'],1,'Cần nhanh chóng hạn chế thiệt hại bằng cách gỡ ứng dụng, ngắt kết nối và liên hệ ngân hàng nếu cần.'),

      q('malware','Bạn nhận được email có tệp đính kèm tên "HoaDon.pdf.exe". Bạn nên làm gì?',['Mở ngay vì là hóa đơn','Đổi tên tệp rồi mở','Không mở tệp và xác minh với người gửi trước','Gửi cho bạn bè kiểm tra'],2,'Tin tặc thường ngụy trang mã độc dưới dạng hóa đơn hoặc tài liệu.'),

      q('malware','Bạn nhận được USB từ một người lạ và muốn xem bên trong có gì. Bạn nên làm gì?',['Cắm ngay vào máy tính','Chỉ cắm sau khi đã kiểm tra bằng phần mềm diệt virus hoặc không sử dụng nếu không rõ nguồn gốc','Cắm vào máy tính của người khác trước','Sao chép toàn bộ dữ liệu ngay'],1,'USB không rõ nguồn gốc có thể chứa mã độc và lây nhiễm sang máy tính.'),

      q('malware','Điều nào dưới đây giúp hạn chế nguy cơ nhiễm mã độc?',['Chỉ tải ứng dụng từ CH Play hoặc App Store','Tải ứng dụng từ bất kỳ website nào','Tắt phần mềm diệt virus','Bật cài đặt từ nguồn không xác định'],0,'Kho ứng dụng chính thức có cơ chế kiểm tra bảo mật giúp giảm nguy cơ tải phải mã độc.'),

      q('malware','Điện thoại yêu cầu bạn bật "Cài đặt ứng dụng từ nguồn không xác định". Bạn nên làm gì?',['Bật ngay để cài ứng dụng','Chỉ bật khi thật sự cần và ứng dụng đến từ nguồn đáng tin cậy; bình thường nên để tắt','Luôn để chế độ này bật','Không cần quan tâm'],1,'Việc bật cài đặt từ nguồn không xác định làm tăng nguy cơ cài phải ứng dụng chứa mã độc.'),

      q('malware','Sau khi cài một ứng dụng lạ, điện thoại liên tục yêu cầu cấp quyền đọc tin nhắn và quyền trợ năng (Accessibility). Bạn nên làm gì?',['Cấp toàn bộ quyền','Từ chối, gỡ ứng dụng nếu thấy bất thường','Khởi động lại máy','Bỏ qua và tiếp tục sử dụng'],1,'Mã độc thường yêu cầu quyền đọc SMS hoặc quyền trợ năng để đánh cắp OTP và điều khiển thiết bị.'),

      q('malware','Phần mềm diệt virus trên máy tính có tác dụng gì?',['Tăng tốc độ Internet','Phát hiện và ngăn chặn một số loại mã độc','Tăng dung lượng ổ cứng','Tự động sửa mọi lỗi máy tính'],1,'Phần mềm diệt virus giúp phát hiện, cảnh báo và loại bỏ nhiều loại mã độc.'),

      q('malware','Bạn nhận được tin nhắn yêu cầu cập nhật ứng dụng ngân hàng qua một đường link lạ. Bạn nên làm gì?',['Cập nhật ngay','Chỉ cập nhật qua CH Play, App Store hoặc website chính thức của ngân hàng','Chuyển tiếp cho người khác','Mở link để xem trước'],1,'Không cập nhật ứng dụng qua đường link lạ vì có thể dẫn đến cài đặt mã độc.'),

      q('malware','Nếu nghi ngờ điện thoại đã bị mã độc chiếm quyền điều khiển, việc nào nên làm đầu tiên?',['Tiếp tục sử dụng bình thường','Liên hệ ngay ngân hàng để khóa tài khoản nếu đã đăng nhập ứng dụng ngân hàng','Chờ vài ngày xem có hết không','Xóa ảnh trong điện thoại'],1,'Nếu thiết bị đã bị mã độc kiểm soát, cần nhanh chóng khóa tài khoản ngân hàng để hạn chế thiệt hại.'),

      q('malware','Vì sao không nên cài ứng dụng từ các đường link được gửi qua tin nhắn hoặc mạng xã hội?',['Vì tò mò muốn biết trong đó có gì','Vì sẽ làm điện thoại nặng hơn','Vì không xem được video','Vì ứng dụng có thể chứa mã độc'],3,'Ứng dụng từ đường link lạ có thể là ứng dụng giả mạo chứa mã độc.'),

      q('malware','Khi phát hiện mình đã cài ứng dụng giả mạo chứa mã độc, bạn nên làm gì?',['Gỡ ứng dụng, liên hệ ngân hàng nếu có nguy cơ lộ tài khoản và trình báo cơ quan Công an','Chỉ khởi động lại điện thoại','Không làm gì','Tiếp tục đăng nhập ứng dụng ngân hàng'],0,'Gỡ ứng dụng, liên hệ ngân hàng khi cần và trình báo cơ quan chức năng để hạn chế thiệt hại.'),
      q('privacy','Bạn đăng ảnh chụp màn hình đơn hàng lên Facebook. Trong ảnh vô tình có tên, số điện thoại và địa chỉ nhận hàng. Cách xử lý tốt nhất là gì?',['Đăng vì chỉ bạn bè mới xem được','Đăng rồi xóa sau vài giờ','Che hoặc làm mờ thông tin cá nhân trước khi đăng','Chỉ cần che tên là đủ'],2,'Số điện thoại và địa chỉ có thể bị người khác thu thập và lợi dụng. Nên kiểm tra kỹ nội dung trước khi đăng.'),

      q('privacy','Một người lạ biết tên, ngày sinh và trường học của bạn rồi nhắn tin hỏi thêm địa chỉ nhà. Bạn nên làm gì?',['Cung cấp vì họ đã biết nhiều thông tin rồi','Cung cấp nếu họ tự giới thiệu là người quen của bạn bè','Không cung cấp và xác minh danh tính, mục đích của họ','Gửi địa chỉ nhưng không gửi số điện thoại'],2,'Kẻ xấu có thể ghép nhiều thông tin nhỏ để xây dựng hồ sơ về một người. Không nên cung cấp thêm thông tin cá nhân cho người không xác định rõ danh tính.'),

      q('privacy','Bạn muốn đăng ảnh CCCD lên mạng để "chứng minh mình đủ tuổi". Lựa chọn nào an toàn hơn?',['Đăng cả hai mặt CCCD','Đăng mặt trước nhưng che số CCCD','Không công khai CCCD nếu không thực sự cần thiết','Đăng nhưng giới hạn người xem'],2,'CCCD chứa nhiều thông tin cá nhân quan trọng. Việc công khai trên mạng có thể tạo điều kiện để kẻ xấu thu thập và lợi dụng.'),

      q('privacy','Một ứng dụng đèn pin yêu cầu quyền truy cập danh bạ, microphone và vị trí. Điều nào đáng cân nhắc nhất?',['Cấp tất cả quyền vì ứng dụng miễn phí','Cấp quyền vì điện thoại sẽ hoạt động nhanh hơn','Xem xét tính cần thiết của từng quyền và từ chối quyền không phù hợp','Cấp quyền nếu ứng dụng có nhiều lượt tải'],2,'Một ứng dụng chỉ nên được cấp những quyền cần thiết cho chức năng của nó. Việc cấp quá nhiều quyền có thể làm tăng nguy cơ lộ dữ liệu cá nhân.'),

      q('privacy','Bạn bè gửi ảnh của bạn trong một khoảnh khắc riêng tư và muốn đăng công khai. Bạn nên làm gì?',['Đồng ý vì là bạn bè','Yêu cầu họ cân nhắc hoặc xin phép trước khi đăng','Đăng lại để "trả đũa"','Chia sẻ vào nhóm kín'],1,'Tôn trọng quyền riêng tư không chỉ áp dụng với thông tin của mình mà còn với hình ảnh và thông tin của người khác.'),

      q('privacy','Bạn thấy một bài đăng công khai có thông tin cá nhân của người khác. Bạn có thể tự ý sao chép và đăng lại ở nơi khác không?',['Có, vì bài đăng đã công khai','Có, nếu không kiếm tiền','Không nên mặc nhiên cho rằng được phép; cần tôn trọng quyền riêng tư và quy định liên quan','Có, nếu chỉ đăng trong nhóm kín'],2,'Thông tin công khai không đồng nghĩa với việc có thể tùy ý sao chép và phát tán ở mọi nơi.'),

      q('privacy','Bạn thường xuyên đăng ảnh check-in theo thời gian thực. Rủi ro nào đáng lưu ý nhất?',['Tài khoản sẽ tự động bị khóa','Người khác có thể biết vị trí hoặc lịch trình của bạn','Điện thoại sẽ hết pin nhanh hơn','Mạng xã hội sẽ tự động xóa ảnh'],1,'Việc chia sẻ vị trí theo thời gian thực có thể giúp người khác theo dõi thói quen hoặc lịch trình cá nhân.'),

      q('privacy','Một website yêu cầu bạn nhập ngày sinh, địa chỉ và số CCCD để nhận quà. Bạn nên làm gì?',['Điền vì quà miễn phí','Điền nếu website có giao diện đẹp','Kiểm tra nguồn gốc, mục đích và tính cần thiết trước khi cung cấp','Điền thông tin giả'],2,'Không nên cung cấp dữ liệu cá nhân chỉ vì lời hứa nhận quà. Cần xác minh đơn vị và mục đích thu thập dữ liệu.'),

      q('privacy','Khi bán điện thoại cũ, hành động nào giúp bảo vệ quyền riêng tư tốt hơn?',['Chỉ xóa ảnh','Xóa ứng dụng mạng xã hội','Sao lưu dữ liệu cần thiết, đăng xuất tài khoản và khôi phục cài đặt gốc','Đổi hình nền'],2,'Điện thoại có thể lưu tài khoản, ảnh, tin nhắn và nhiều dữ liệu khác. Cần xóa dữ liệu đúng cách trước khi giao thiết bị.'),

      q('privacy','Bạn nhận được tin nhắn: "Tôi biết thông tin của bạn rồi, hãy gửi ảnh CCCD để tôi xác nhận". Bạn nên làm gì?',['Gửi vì họ đã biết thông tin','Gửi một phần CCCD','Không cung cấp và xác minh danh tính, mục đích qua kênh chính thức','Gửi CCCD của người khác'],2,'Việc người lạ biết một vài thông tin không chứng minh họ có quyền yêu cầu thêm dữ liệu.'),

      q('privacy','Một tài khoản mạng xã hội của bạn đang để công khai toàn bộ ngày sinh, số điện thoại và địa chỉ. Cách tốt hơn là gì?',['Giữ nguyên vì thông tin càng đầy đủ càng dễ kết bạn','Hạn chế thông tin công khai và điều chỉnh quyền riêng tư','Đăng thêm CCCD để xác minh','Công khai cả lịch trình cá nhân'],1,'Càng nhiều thông tin được công khai, kẻ xấu càng dễ thu thập và kết hợp chúng để giả mạo hoặc lừa đảo.'),

      q('privacy','Bạn bè đăng ảnh có bạn lên mạng nhưng bạn không muốn ảnh được công khai. Bạn nên làm gì?',['Đăng thông tin riêng tư của bạn ấy để trả đũa','Yêu cầu bạn gỡ ảnh hoặc hạn chế người xem','Tạo tài khoản giả để công kích','Chia sẻ ảnh vào nhóm khác'],1,'Cách xử lý phù hợp là trao đổi trực tiếp và yêu cầu gỡ hoặc điều chỉnh quyền xem.'),

      q('privacy','Điều nào sau đây không đảm bảo tuyệt đối quyền riêng tư trên mạng xã hội?',['Tài khoản ở chế độ riêng tư','Không công khai dữ liệu nhạy cảm','Chỉ đăng trong nhóm kín','Tất cả các biện pháp trên đều không đảm bảo tuyệt đối'],3,'Nhóm kín hay tài khoản riêng tư vẫn có nguy cơ bị chụp màn hình, sao chép hoặc chia sẻ lại.'),

      q('privacy','Một người lạ gửi cho bạn ảnh chụp màn hình chứa thông tin cá nhân của một người khác. Bạn nên làm gì?',['Chia sẻ tiếp để cảnh báo mọi người','Đăng lên nhóm kín','Không phát tán thêm nếu không có lý do chính đáng','Bán thông tin cho người khác'],2,'Việc tiếp tục phát tán thông tin có thể làm tăng phạm vi lộ lọt dữ liệu và xâm phạm quyền riêng tư.'),

      q('privacy','Thói quen nào thể hiện tốt nhất việc tôn trọng quyền riêng tư trên mạng?',['Không đăng thông tin của mình nhưng có thể đăng thông tin của người khác','Kiểm tra kỹ trước khi chia sẻ và tôn trọng thông tin cá nhân của người khác','Chỉ cần xin phép bạn thân là được đăng thông tin của bất kỳ ai','Đăng thông tin trong nhóm kín là luôn an toàn'],1,'Quyền riêng tư không chỉ liên quan đến việc bảo vệ bản thân mà còn yêu cầu mỗi người có ý thức tôn trọng thông tin cá nhân của người khác.'),
      q('wifi','Bạn đang ở quán cà phê và muốn chuyển khoản ngân hàng. Bạn nên làm gì?',['Dùng Wi-Fi miễn phí của quán để chuyển khoản','Dùng mạng 4G/5G hoặc Wi-Fi tin cậy để giao dịch','Nhờ người bên cạnh phát Wi-Fi','Đợi có nhiều người cùng dùng rồi chuyển khoản'],1,'Wi-Fi công cộng có thể bị lợi dụng để đánh cắp dữ liệu. Khi giao dịch tài chính nên dùng mạng di động hoặc Wi-Fi đáng tin cậy.'),

      q('wifi','Bạn thấy có hai mạng Wi-Fi: Coffee_Free và Coffee_Free_5G. Bạn không biết mạng nào là của quán. Bạn nên làm gì?',['Chọn mạng có sóng mạnh hơn','Hỏi nhân viên quán tên Wi-Fi chính xác','Kết connect thử từng mạng','Chọn mạng không cần mật khẩu'],1,'Tin tặc có thể tạo Wi-Fi giả có tên gần giống Wi-Fi thật để đánh cắp thông tin.'),

      q('wifi','Sau khi dùng Wi-Fi công cộng xong, bạn nên làm gì?',['Để điện thoại tự động kết connect lần sau','Quên (Forget) mạng Wi-Fi hoặc tắt tự động kết connect','Không cần làm gì','Chỉ cần tắt màn hình'],1,'Nếu điện thoại tự động kết connect lại, bạn có thể vô tình kết connect vào điểm phát Wi-Fi giả.'),

      q('wifi','Khi truy cập một trang web để đăng nhập tài khoản, dấu hiệu nào cho thấy kết connect an toàn hơn?',['Website có nhiều quảng cáo','Địa chỉ bắt đầu bằng https:// và có biểu tượng ổ khóa','Website có màu xanh','Website tải rất nhanh'],1,'HTTPS giúp mã hóa dữ liệu truyền giữa thiết bị và website, giảm nguy cơ bị nghe lén.'),

      q('wifi','Việc nào dưới đây KHÔNG nên thực hiện khi đang dùng Wi-Fi công cộng?',['Đọc tin tức','Xem video','Đăng nhập Internet Banking hoặc nhập thông tin thẻ ngân hàng','Tìm đường trên bản đồ'],2,'Các giao dịch ngân hàng nên thực hiện trên mạng đáng tin cậy để giảm nguy cơ lộ dữ liệu.'),

      q('wifi','Bạn vừa kết nối Wi-Fi miễn phí tại sân bay. Một cửa sổ hiện lên yêu cầu tải ứng dụng để tiếp tục truy cập Internet. Bạn nên làm gì?',['Tải ngay vì đây là yêu cầu của sân bay','Chỉ tải nếu ứng dụng được giới thiệu trên website hoặc cửa hàng ứng dụng chính thức','Tắt Wi-Fi rồi bật lại','Cho phép tải bất kỳ ứng dụng nào để có Internet'],1,'Chỉ nên cài ứng dụng từ Google Play, App Store hoặc nguồn chính thức để tránh mã độc.'),

      q('wifi','Bạn nhận được tin nhắn: "Wi-Fi của bạn có nguy cơ bị tấn công. Nhấn vào đường link dưới đây để kiểm tra ngay." Bạn nên làm gì?',['Nhấn ngay vì đây là cảnh báo khẩn cấp','Chuyển tiếp cho bạn bè','Không nhấn vào liên kết lạ và kiểm tra thông tin từ đơn vị cung cấp dịch vụ hoặc cơ quan chính thức','Điền đầy đủ thông tin cá nhân để xác minh'],2,'Liên kết lạ là hình thức lừa đảo phổ biến nhằm đánh cắp tài khoản hoặc cài mã độc.'),

      q('wifi','Trong các mật khẩu Wi-Fi dưới đây, mật khẩu nào an toàn nhất?',['12345678','password','abc12345','T8@Lan2026#Home'],3,'Mật khẩu mạnh nên dài, kết hợp chữ hoa, chữ thường, số và ký tự đặc biệt.'),

      q('wifi','Bạn phát hiện Wi-Fi ở nhà vẫn đang sử dụng mật khẩu mặc định do nhà mạng cài sẵn. Bạn nên làm gì?',['Giữ nguyên vì nhà mạng đã đặt','Đổi sang mật khẩu mạnh và chỉ chia sẻ cho người cần sử dụng','Dán mật khẩu lên cửa nhà để mọi người dễ nhớ','Đăng mật khẩu lên mạng xã hội'],1,'Đổi mật khẩu mặc định giúp hạn chế nguy cơ truy cập trái phép.'),

      q('wifi','Bạn đang sử dụng Wi-Fi công cộng thì điện thoại xuất hiện thông báo: "Phiên đăng nhập của bạn đã hết hạn. Vui lòng nhập lại tên đăng nhập và mật khẩu Facebook." Bạn nên làm gì?',['Đăng nhập ngay để tiếp tục sử dụng Internet','Kiểm tra kỹ địa chỉ trang web, chỉ đăng nhập nếu đó là trang chính thức của Facebook','Đăng nhập bằng tài khoản Google thay thế','Nhờ người khác đăng nhập giúp'],1,'Không nên nhập thông tin đăng nhập vào các trang web không xác minh được vì có thể là phishing.'),

      q('wifi','Khi sử dụng Wi-Fi công cộng, bạn nên tránh làm việc nào dưới đây?',['Đọc báo','Xem video','Đăng nhập tài khoản ngân hàng','Tìm kiếm thông tin'],2,'Không nên đăng nhập Internet Banking hoặc thực hiện giao dịch tài chính trên Wi-Fi công cộng.'),

      q('wifi','Nếu không sử dụng Wi-Fi nữa, bạn nên làm gì?',['Tắt kết nối Wi-Fi hoặc quên (Forget) mạng đã kết nối','Luôn để Wi-Fi bật','Chia sẻ Wi-Fi cho mọi người','Không cần làm gì'],0,'Việc tắt Wi-Fi hoặc quên mạng giúp hạn chế thiết bị tự động kết nối vào các mạng không an toàn.'),

      q('wifi','Khi phát hiện mạng Wi-Fi ở nhà có dấu hiệu chậm bất thường dù không có nhiều người sử dụng, bạn nên làm gì đầu tiên?',['Tắt hẳn modem và không dùng Internet nữa','Kiểm tra danh sách thiết bị đang kết nối và đổi mật khẩu Wi-Fi nếu phát hiện thiết bị lạ','Tiếp tục sử dụng vì mạng chậm là bình thường','Đăng mật khẩu Wi-Fi lên mạng xã hội để nhờ mọi người kiểm tra'],1,'Kiểm tra thiết bị đang kết nối và đổi mật khẩu nếu nghi ngờ có truy cập trái phép.'),

      q('wifi','Khi thấy một mạng Wi-Fi miễn phí có tên giống cửa hàng, bạn nên làm gì?',['Kết connect ngay','Hỏi nhân viên xem đó có phải Wi-Fi chính thức không','Chọn mạng có sóng mạnh nhất','Chia sẻ cho bạn bè cùng kết connect'],1,'Kẻ gian có thể tạo Wi-Fi giả có tên giống Wi-Fi thật để lừa người dùng kết connect.'),
      q('wifi','Khi truy cập một website để đăng nhập tài khoản, bạn nên kiểm tra điều gì?',['Website có nhiều hình ảnh đẹp','Địa chỉ website bắt đầu bằng https://','Website tải nhanh','Website có nhiều quảng cáo'],1,'HTTPS giúp mã hóa dữ liệu khi truyền trên Internet và an toàn hơn HTTP.'),
      q('social','Bạn nhận được tin nhắn Facebook từ người thân hỏi vay gấp 5 triệu đồng. Bạn nên làm gì?',['Chuyển tiền ngay','Gọi điện hoặc liên hệ bằng cách khác để xác minh trước khi chuyển tiền','Chuyển một nửa số tiền','Hỏi số tài khoản rồi chuyển'],1,'Tài khoản Facebook có thể đã bị chiếm quyền hoặc bị giả mạo. Hãy xác minh bằng cuộc gọi hoặc gặp trực tiếp trước khi chuyển tiền.'),

      q('social','Bạn thấy một Fanpage mang tên "Bộ Công an" nhưng yêu cầu nhắn tin để lấy lại tiền bị lừa. Bạn nên làm gì?',['Nhắn tin ngay','Chuyển phí để được hỗ trợ','Kiểm tra đó có phải kênh chính thức hay không','Chia sẻ cho bạn bè'],2,'Nhiều fanpage giả mạo cơ quan Công an được lập để tiếp tục lừa những người đã từng là nạn nhân.'),

      q('social','Người lạ kết bạn Facebook rồi mời bạn tham gia đầu tư lợi nhuận 30%/tháng. Bạn nên làm gì?',['Tham gia ngay vì lợi nhuận cao','Chỉ đầu tư số tiền nhỏ','Từ chối và không chuyển tiền cho người lạ','Mượn tiền để đầu tư'],2,'Đây là kịch bản lừa đảo đầu tư rất phổ biến trên mạng xã hội.'),

      q('social','Một người tự xưng là nhân viên Facebook nhắn tin yêu cầu bạn cung cấp mã OTP để mở khóa tài khoản. Bạn nên làm gì?',['Gửi ngay mã OTP','Không cung cấp OTP cho bất kỳ ai','Chụp màn hình OTP gửi cho họ','Đổi ảnh đại diện'],1,'Facebook không yêu cầu người dùng gửi OTP qua Messenger.'),

      q('social','Khi thấy bài viết "Bấm vào đây để nhận 5 triệu đồng từ Chính phủ", bạn nên làm gì?',['Nhấn ngay','Kiểm tra thông báo trên cổng thông tin chính thức của cơ quan nhà nước','Chia sẻ cho mọi người','Điền CCCD ngay'],1,'Các đối tượng lừa đảo thường lợi dụng các chương trình hỗ trợ của Nhà nước để phát tán đường link giả mạo nhằm đánh cắp thông tin.'),

      q('social','Điều nào dưới đây là dấu hiệu của tài khoản Facebook giả mạo?',['Ít bạn bè, mới tạo, thường nhắn tin vay tiền hoặc gửi link','Có ảnh đại diện','Có tên tiếng Việt','Có bài đăng'],0,'Tài khoản giả mạo thường mới lập và có hành vi bất thường nhằm lừa đảo.'),

      q('social','Khi nhận được lời mời kết bạn từ người không quen, bạn nên làm gì?',['Chấp nhận tất cả','Kiểm tra thông tin trước khi đồng ý','Chấp nhận rồi mới xem','Gửi số điện thoại cho họ'],1,'Không nên kết bạn bừa bãi vì có thể bị thu thập thông tin hoặc dẫn dụ lừa đảo.'),

      q('social','Nếu nghi ngờ tài khoản Facebook của mình bị chiếm quyền, bạn nên làm gì đầu tiên?',['Bỏ qua vì có thể là lỗi hệ thống','Đổi mật khẩu ngay và kiểm tra các thiết bị đang đăng nhập','Tạo tài khoản Facebook mới','Xóa ứng dụng Facebook'],1,'Nếu phát hiện tài khoản có dấu hiệu bị chiếm quyền, hãy đổi mật khẩu ngay, đăng xuất khỏi các thiết bị lạ và bật xác thực hai yếu tố.'),

      q('social','Bạn thấy một livestream bán hàng với giá rẻ bất thường và yêu cầu chuyển khoản đặt cọc trước. Bạn nên làm gì?',['Chuyển tiền đặt cọc ngay để giữ đơn','Kiểm tra uy tín người bán và chỉ giao dịch qua kênh đáng tin cậy trước khi thanh toán','Chuyển một nửa số tiền','Tin tưởng vì livestream có nhiều người xem'],1,'Các đối tượng lừa đảo thường lợi dụng livestream để dụ người mua chuyển tiền đặt cọc rồi chiếm đoạt.'),

      q('social','Bạn nhận được đường link "Bình chọn giúp mình". Sau khi bấm vào, website yêu cầu đăng nhập Facebook. Bạn nên làm gì?',['Đăng nhập','Không đăng nhập nếu không chắc website chính thức','Đổi mật khẩu sau khi đăng nhập','Gửi link cho bạn bè'],1,'Đây là thủ đoạn phishing nhằm chiếm đoạt tài khoản Facebook.'),

      q('social','Bạn nên chia sẻ thông tin nào dưới đây ở chế độ công khai trên mạng xã hội?',['CCCD','Mã OTP','Số tài khoản và mật khẩu','Không chia sẻ các thông tin nhạy cảm trên'],3,'Thông tin cá nhân nhạy cảm có thể bị lợi dụng để giả mạo hoặc lừa đảo.'),

      q('social','Khi thấy bài viết kêu gọi quyên góp từ thiện từ một tài khoản cá nhân, bạn nên làm gì?',['Chuyển tiền ngay','Kiểm tra tính xác thực của người kêu gọi và thông tin chương trình','Chia sẻ ngay','Bình luận số điện thoại'],1,'Nhiều đối tượng lợi dụng lòng tốt để lập tài khoản giả kêu gọi từ thiện.'),

      q('social','Mục đích phổ biến của việc chiếm quyền tài khoản Facebook/Zalo là gì?',['Tăng lượt thích','Mạo danh để vay tiền hoặc phát tán link lừa đảo','Tăng dung lượng điện thoại','Cập nhật phần mềm'],1,'Sau khi chiếm tài khoản, kẻ gian thường nhắn tin vay tiền hoặc gửi liên kết độc hại cho bạn bè của nạn nhân.'),

      q('social','Nếu nghi ngờ Fanpage của cơ quan nhà nước là giả mạo, bạn nên làm gì?',['Nhắn tin ngay','Kiểm tra trên website chính thức hoặc các kênh xác thực của cơ quan đó','Chuyển tiền theo hướng dẫn','Chia sẻ Fanpage'],1,'Chỉ nên làm việc với các tài khoản mạng xã hội đã được cơ quan xác nhận là chính thức.'),

      q('social','Cách tốt nhất để hạn chế bị lừa đảo trên mạng xã hội là gì?',['Tin vào mọi tài khoản có ảnh đại diện đẹp','Luôn kiểm chứng thông tin và không chuyển tiền khi chưa xác minh','Chỉ xem số lượt theo dõi','Chỉ đọc bình luận'],1,'Đa số các vụ lừa đảo trên mạng xã hội đều lợi dụng sự thiếu kiểm chứng của người dùng. Hãy xác minh thông tin qua kênh chính thức trước khi giao dịch.'),
      q('law','Theo pháp luật hiện hành, dữ liệu cá nhân được hiểu gần nhất là gì?',['Chỉ những thông tin được ghi trên CCCD','Thông tin có thể xác định hoặc giúp xác định một cá nhân','Chỉ thông tin mà cá nhân tự đăng công khai','Chỉ thông tin được lưu trên máy tính'],1,'Dữ liệu cá nhân không chỉ là CCCD hay thông tin công khai mà bao gồm nhiều loại thông tin có thể xác định hoặc giúp xác định một cá nhân.'),

      q('law','Một người tìm thấy số điện thoại của bạn trên một bài đăng công khai. Người đó có thể tự do thu thập và bán số điện thoại đó cho bên thứ ba không?',['Có, vì thông tin đã được đăng công khai','Có, nếu người mua cam kết không tiết lộ','Không mặc nhiên; việc xử lý dữ liệu vẫn phải tuân thủ quy định pháp luật','Có, nếu chỉ bán một lần'],2,'Việc dữ liệu xuất hiện công khai không đồng nghĩa với việc bất kỳ ai cũng có quyền tự do thu thập, mua bán hoặc sử dụng dữ liệu đó.'),

      q('law','Theo quy định hiện hành, hành vi nào dưới đây có nguy cơ vi phạm pháp luật về dữ liệu cá nhân?',['Tự lưu số điện thoại của mình','Tự ý mua bán trái phép dữ liệu cá nhân của nhiều người','Đổi mật khẩu tài khoản cá nhân','Xóa ảnh cá nhân trên điện thoại'],1,'Việc thu thập, mua bán hoặc trao đổi dữ liệu cá nhân trái phép có thể bị xử lý theo quy định pháp luật.'),

      q('law','Nghị định 356/2025/NĐ-CP có vai trò gì?',['Quy định về giao thông đường bộ','Quy định chi tiết một số điều và biện pháp thi hành Luật Bảo vệ dữ liệu cá nhân','Quy định riêng về mạng xã hội','Quy định về giáo dục trực tuyến'],1,'Nghị định 356/2025/NĐ-CP quy định chi tiết một số điều và biện pháp thi hành Luật Bảo vệ dữ liệu cá nhân.'),

      q('law','Luật Bảo vệ dữ liệu cá nhân số 91/2025/QH15 có hiệu lực từ thời điểm nào?',['01/01/2025','01/07/2025','01/01/2026','01/07/2026'],2,'Luật Bảo vệ dữ liệu cá nhân số 91/2025/QH15 có hiệu lực từ ngày 01/01/2026.'),

      q('law','Một công ty thu thập thông tin khách hàng để cung cấp dịch vụ. Công ty muốn sử dụng những dữ liệu đó cho một mục đích hoàn toàn khác. Cách hiểu nào phù hợp nhất?',['Đương nhiên được phép vì dữ liệu đã được thu thập','Có thể sử dụng tùy ý nếu công ty sở hữu cơ sở dữ liệu','Việc sử dụng phải căn cứ vào quy định pháp luật và mục đích xử lý dữ liệu phù hợp','Chỉ cần nhân viên công ty đồng ý'],2,'Việc đã có dữ liệu không đồng nghĩa với quyền sử dụng dữ liệu vô hạn. Hoạt động xử lý dữ liệu phải tuân thủ quy định pháp luật.'),

      q('law','Hành vi nào dưới đây có thể bị xem là xâm phạm nghiêm trọng quyền riêng tư và dữ liệu cá nhân?',['Chia sẻ ảnh phong cảnh','Tự ý thu thập và công khai hàng loạt thông tin cá nhân của người khác','Đổi ảnh đại diện','Xóa bài viết của mình'],1,'Việc thu thập và công khai trái phép dữ liệu cá nhân có thể xâm phạm quyền riêng tư và tạo điều kiện cho các hành vi lừa đảo, giả mạo hoặc chiếm đoạt tài sản.'),

      q('law','Khi một cá nhân cung cấp dữ liệu cá nhân cho một tổ chức, điều nào sau đây là phù hợp nhất?',['Tổ chức có thể bán dữ liệu cho bất kỳ ai','Tổ chức phải xử lý dữ liệu theo quy định pháp luật','Tổ chức có thể sử dụng dữ liệu vĩnh viễn cho mọi mục đích','Dữ liệu trở thành tài sản riêng của tổ chức'],1,'Việc một tổ chức được cung cấp dữ liệu không đồng nghĩa với việc tổ chức có quyền sử dụng dữ liệu tùy ý. Hoạt động xử lý dữ liệu phải tuân thủ pháp luật.'),

      q('law','Một người mua được danh sách hàng nghìn số điện thoại cá nhân trên mạng. Hành động nào dưới đây là phù hợp?',['Gọi điện quảng cáo hàng loạt vì đã mua dữ liệu','Bán lại danh sách để kiếm lời','Không mặc nhiên được phép sử dụng hoặc mua bán dữ liệu trái pháp luật','Đăng danh sách lên mạng xã hội'],2,'Việc mua được dữ liệu không đồng nghĩa với việc dữ liệu đó được sử dụng hợp pháp.'),

      q('law','Mục tiêu quan trọng của pháp luật về bảo vệ dữ liệu cá nhân là gì?',['Cấm mọi người sử dụng Internet','Bảo vệ quyền và lợi ích hợp pháp của cá nhân liên quan đến dữ liệu','Cấm tất cả việc thu thập dữ liệu','Cấm sử dụng mạng xã hội'],1,'Pháp luật không cấm mọi hoạt động xử lý dữ liệu mà xây dựng khuôn khổ để bảo vệ quyền và lợi ích hợp pháp của cá nhân.'),

      q('law','Nếu một doanh nghiệp làm lộ dữ liệu cá nhân của khách hàng, cách hiểu nào đúng nhất?',['Doanh nghiệp luôn được miễn trách nhiệm','Có thể phát sinh trách nhiệm theo quy định pháp luật tùy vào hành vi và mức độ vi phạm','Chỉ cần xin lỗi trên mạng xã hội','Chỉ khách hàng phải tự chịu trách nhiệm'],1,'Các tổ chức xử lý dữ liệu phải có trách nhiệm bảo vệ dữ liệu theo quy định. Khi xảy ra vi phạm, trách nhiệm cụ thể được xác định theo pháp luật.'),

      q('law','Thông tin nào dưới đây không nên được xem là mặc nhiên "vô chủ" chỉ vì nó xuất hiện trên Internet?',['Số điện thoại cá nhân','Địa chỉ email cá nhân','Hình ảnh cá nhân','Tất cả các đáp án trên'],3,'Thông tin xuất hiện trên Internet vẫn có thể là dữ liệu cá nhân. Việc được đăng tải công khai không đồng nghĩa với việc mọi người có quyền tùy ý sử dụng.'),

      q('law','Hành vi nào sau đây có thể tiếp tay cho tội phạm công nghệ cao?',['Tự ý mua bán dữ liệu cá nhân','Bảo vệ mật khẩu cá nhân','Bật xác thực nhiều lớp','Xóa dữ liệu không cần thiết'],0,'Dữ liệu cá nhân bị mua bán trái phép có thể bị sử dụng để giả mạo, lừa đảo hoặc chiếm đoạt tài sản.'),

      q('law','Năm 2026, văn bản nào dưới đây là luật chuyên biệt về bảo vệ dữ liệu cá nhân tại Việt Nam?',['Luật Bảo vệ dữ liệu cá nhân số 91/2025/QH15','Nghị định 13/2023/NĐ-CP','Luật Giao thông đường bộ','Luật Giáo dục'],0,'Từ ngày 01/01/2026, Luật Bảo vệ dữ liệu cá nhân số 91/2025/QH15 có hiệu lực.'),

      q('law','Một người tự ý đăng bán cơ sở dữ liệu chứa thông tin cá nhân của nhiều người. Cách hiểu nào đúng nhất?',['Hợp pháp vì người bán không trực tiếp lừa đảo','Không có vấn đề nếu dữ liệu được bán trong nhóm kín','Có thể là hành vi vi phạm pháp luật và bị xử lý tùy tính chất, mức độ','Hợp pháp nếu người mua cam kết giữ bí mật'],2,'Mua bán, trao đổi hoặc công khai trái phép dữ liệu cá nhân có thể bị xử lý theo pháp luật. Việc giao dịch trong nhóm kín không làm cho hành vi tự động trở thành hợp pháp.'),
      q('safe','Bạn nhận được một đường link từ tài khoản của người bạn thân nhưng người bạn không nói gì thêm. Bạn nên làm gì?',['Nhấp ngay vì là bạn thân','Hỏi lại bạn và xác minh link trước khi mở','Chuyển tiếp cho người khác mở thử','Mở bằng chế độ ẩn danh'],1,'Tài khoản của bạn bè có thể đã bị chiếm quyền. Hãy xác minh với người gửi trước khi nhấn vào bất kỳ đường link nào.'),

      q('safe','Bạn nhận được mã OTP dù không thực hiện đăng nhập. Bạn nên làm gì?',['Gửi OTP cho người gọi tự xưng là nhân viên hỗ trợ','Không cung cấp OTP và kiểm tra, bảo vệ tài khoản nếu nghi ngờ có truy cập trái phép','Đăng OTP lên mạng hỏi mọi người','Chuyển OTP cho bạn bè'],1,'Nếu bạn không yêu cầu OTP mà vẫn nhận được, có thể có người đang cố đăng nhập tài khoản của bạn. Tuyệt đối không chia sẻ mã OTP.'),

      q('safe','Một người tự xưng là cán bộ gọi điện yêu cầu bạn chuyển tiền vào "tài khoản an toàn". Bạn nên làm gì?',['Chuyển ngay nếu người đó biết thông tin cá nhân của bạn','Chuyển một khoản nhỏ để kiểm tra','Dừng giao dịch và xác minh qua kênh chính thức','Cung cấp OTP để họ kiểm tra tài khoản'],2,'Không chuyển tiền theo yêu cầu của người gọi điện khi chưa xác minh danh tính qua kênh chính thức.'),

      q('safe','Bạn được gửi đường link yêu cầu cài ứng dụng để "cập nhật thông tin bảo hiểm". Bạn nên làm gì?',['Cài ngay nếu người gửi tự xưng là cán bộ','Cài nếu ứng dụng có logo cơ quan nhà nước','Kiểm tra thông tin qua kênh chính thức trước khi cài ứng dụng','Cài rồi mới kiểm tra'],2,'Kẻ lừa đảo có thể giả danh cơ quan nhà nước để phát tán ứng dụng giả mạo nhằm đánh cắp thông tin.'),

      q('safe','Khi nhận email có tệp đính kèm từ người gửi không quen biết, bạn nên làm gì?',['Mở nếu tiêu đề có vẻ khẩn cấp','Tải xuống rồi mới kiểm tra','Xác minh người gửi và kiểm tra tệp bằng công cụ bảo mật trước khi mở','Chuyển tiếp cho bạn bè'],2,'Tệp đính kèm từ người lạ có thể chứa mã độc hoặc dẫn đến website nguy hiểm.'),

      q('safe','Thói quen sử dụng mật khẩu nào dưới đây an toàn hơn?',['Dùng ngày sinh cho mọi tài khoản','Dùng một mật khẩu cho tất cả tài khoản','Dùng mật khẩu mạnh và khác nhau cho các tài khoản quan trọng','Gửi mật khẩu cho bạn thân để phòng quên'],2,'Sử dụng mật khẩu mạnh và khác nhau giúp giảm nguy cơ nhiều tài khoản cùng bị xâm nhập.'),

      q('safe','Khi sử dụng Wi-Fi công cộng không rõ mức độ an toàn, bạn nên đặc biệt hạn chế việc nào?',['Đọc báo','Xem video','Thực hiện giao dịch tài chính hoặc nhập thông tin nhạy cảm','Đọc tài liệu học tập'],2,'Wi-Fi công cộng có thể không an toàn. Hạn chế đăng nhập tài khoản ngân hàng hoặc thực hiện giao dịch quan trọng.'),

      q('safe','Bạn thấy một ứng dụng ngân hàng yêu cầu cập nhật bằng file APK gửi qua Zalo. Bạn nên làm gì?',['Cài nếu người gửi là bạn bè','Cài nếu file có tên giống ứng dụng ngân hàng','Không cài và chỉ cập nhật ứng dụng qua kênh chính thức','Cài thử trên điện thoại phụ'],2,'Ứng dụng giả mạo có thể đánh cắp thông tin đăng nhập và mã xác thực.'),

      q('safe','Khi phát hiện tài khoản có đăng nhập từ thiết bị lạ, bạn nên làm gì?',['Bỏ qua nếu chưa mất tiền','Đổi mật khẩu và kiểm tra các phiên đăng nhập','Gửi mật khẩu cho người gọi hỗ trợ','Đăng thông tin tài khoản lên mạng xã hội'],1,'Đăng nhập bất thường có thể là dấu hiệu tài khoản đã bị xâm nhập.'),

      q('safe','Bạn nhận được mã QR từ người lạ với lời mời "quét để nhận tiền". Bạn nên làm gì?',['Quét ngay vì không cần nhập mật khẩu','Quét nếu mã có logo ngân hàng','Xác minh nguồn gốc và mục đích trước khi quét','Quét rồi nhập OTP nếu được yêu cầu'],2,'Mã QR có thể dẫn đến website giả mạo hoặc yêu cầu cung cấp thông tin nhạy cảm.'),

      q('safe','Khi bán điện thoại cũ, việc nào dưới đây chưa đủ để bảo vệ tài khoản?',['Đăng xuất tài khoản','Xóa dữ liệu cá nhân','Chỉ xóa ảnh nhưng vẫn giữ tài khoản đăng nhập','Khôi phục cài đặt gốc sau khi sao lưu dữ liệu cần thiết'],2,'Chỉ xóa ảnh không loại bỏ tài khoản đăng nhập và các dữ liệu khác còn lưu trên thiết bị.'),

      q('safe','Bạn nhận được cuộc gọi tự xưng là nhân viên ngân hàng và yêu cầu đọc OTP. Bạn nên làm gì?',['Đọc OTP nếu người gọi biết tên bạn','Đọc OTP nếu số điện thoại giống tổng đài','Không cung cấp OTP và tự liên hệ ngân hàng qua kênh chính thức','Đọc OTP cũ để kiểm tra'],2,'Ngân hàng không yêu cầu khách hàng cung cấp OTP qua điện thoại.'),

      q('safe','Một website có giao diện giống hệt ngân hàng nhưng tên miền có một ký tự khác. Bạn nên làm gì?',['Đăng nhập vì giao diện giống ngân hàng','Đăng nhập nếu website có biểu tượng ổ khóa','Kiểm tra chính xác tên miền và truy cập từ kênh chính thức','Nhập thử mật khẩu sai trước'],2,'Website giả mạo thường sao chép giao diện của website thật nhưng sử dụng tên miền gần giống.'),

      q('safe','Nếu nghi ngờ tài khoản ngân hàng bị lộ thông tin, bạn nên làm gì?',['Chờ xem có mất tiền không','Đăng thông tin tài khoản lên mạng để hỏi','Liên hệ ngân hàng qua kênh chính thức và thực hiện các biện pháp bảo vệ tài khoản','Cung cấp OTP cho người tự xưng là nhân viên ngân hàng'],2,'Khi có dấu hiệu bất thường, hãy liên hệ trực tiếp ngân hàng để được hỗ trợ và bảo vệ tài khoản.'),

      q('safe','Nếu bạn nghi ngờ mình vừa bị lừa đảo trực tuyến, việc nào nên làm trước?',['Xóa toàn bộ tin nhắn để tránh xấu hổ','Tiếp tục làm theo đối tượng để "lấy lại tiền"','Lưu giữ bằng chứng, nhanh chóng liên hệ đơn vị liên quan và trình báo cơ quan chức năng khi cần','Đăng thông tin cá nhân của đối tượng lên mạng'],2,'Giữ lại tin nhắn, số điện thoại, tài khoản nhận tiền và các bằng chứng sẽ hỗ trợ quá trình xác minh và xử lý vụ việc.')
    ];
    function q(topic,text,answers,correct,tip){return{id:'b_'+Math.random().toString(36).slice(2),topic,text,answers,correct,tip,source:src[topic],base:true}}
    const LS_CUSTOM='cyber_custom_questions',LS_DELETED='cyber_deleted_base',LS_RANK='cyber_rank';
    let current=[],idx=0,score=0,selectedTopic='';
    const $=id=>document.getElementById(id);
    function load(k,d){try{return JSON.parse(localStorage.getItem(k))||d}catch{return d}}
    function save(k,v){localStorage.setItem(k,JSON.stringify(v))}
    function custom(){return load(LS_CUSTOM,[])} function deleted(){return load(LS_DELETED,[])}
    function allQuestions(){const del=deleted();return baseQuestions.filter(x=>!del.includes(x.id)).concat(custom())}
    function showSection(id){document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));$(id).classList.add('active'); if(id==='topics')renderTopics(); if(id==='manage')renderManage(); if(id==='rank')renderRank(); window.scrollTo({top:0,behavior:'smooth'})}
    function renderTopics(){const all=allQuestions();$('topicsGrid').innerHTML=topics.map(t=>{const n=all.filter(q=>q.topic===t[0]).length;return `<div class="card topic" onclick="startQuiz('${t[0]}')"><div class="icon">${t[1]}</div><h3>${t[2]}</h3><p class="muted">${n} câu hỏi</p></div>`}).join('');$('statQ').textContent=all.length}
    function startQuiz(topic){selectedTopic=topic;const pool=allQuestions().filter(q=>q.topic===topic).sort(()=>Math.random()-.5);current=pool.slice(0,10);idx=0;score=0;$('scoreText').textContent=0;$('quizTitle').textContent=(topics.find(t=>t[0]===topic)||[])[2]||'Quiz';showSection('quiz');renderQuestion()}
    function renderQuestion(){const item=current[idx];if(!item)return finish();$('quizCount').textContent=`Câu ${idx+1}/${current.length}`;$('progressBar').style.width=(idx/current.length*100)+'%';$('questionText').textContent=item.text;$('answersBox').innerHTML=item.answers.map((a,i)=>`<button class="answer" onclick="selectAnswer(${i})">${String.fromCharCode(65+i)}. ${escapeHtml(a)}</button>`).join('');$('feedback').className='feedback';$('feedback').innerHTML='';$('nextBtn').classList.add('hidden')}
    function selectAnswer(i){const item=current[idx];document.querySelectorAll('.answer').forEach((b,n)=>{b.disabled=true;if(n===item.correct)b.classList.add('correct');if(n===i&&i!==item.correct)b.classList.add('wrong')});if(i===item.correct){score++;$('scoreText').textContent=score}$('feedback').className='feedback show';$('feedback').innerHTML=`<b>${i===item.correct?'✅ Chính xác!':'❌ Chưa đúng!'}</b><br>${escapeHtml(item.tip)}<div class="source">📚 Nguồn: ${escapeHtml(item.source||'Nguồn tham khảo chung')}</div>`;$('nextBtn').classList.remove('hidden')}
    function nextQuestion(){idx++; if(idx>=current.length)finish(); else renderQuestion()}
    function finish(){const pct=Math.round(score/current.length*100)||0;$('progressBar').style.width='100%';$('finalScore').textContent=pct+'%';$('resultMsg').textContent=pct>=80?'Xuất sắc! Bạn rất có ý thức bảo mật.':pct>=50?'Khá tốt! Hãy ôn lại các mẹo vừa học.':'Cố lên! An toàn thông tin cần luyện tập thường xuyên.';const r=load(LS_RANK,[]);r.unshift({date:new Date().toLocaleString('vi-VN'),topic:(topics.find(t=>t[0]===selectedTopic)||[])[2],score,pct,total:current.length});save(LS_RANK,r.slice(0,10));showSection('result')}
    function renderManage(){const sel=$('qTopic');sel.innerHTML=topics.map(t=>`<option value="${t[0]}">${t[1]} ${t[2]}</option>`).join('');const all=allQuestions();$('questionList').innerHTML=all.map(x=>`<div class="qitem"><div><b>${escapeHtml(x.text)}</b><div class="muted">${(topics.find(t=>t[0]===x.topic)||[])[2]} • ${x.base?'Câu gốc':'Tự thêm'}</div></div><button class="btn danger" onclick="deleteQuestion('${x.id}',${x.base?1:0})">🗑️</button></div>`).join('')||'<p class="muted">Chưa có câu hỏi.</p>';renderTopics()}
    $('qForm').addEventListener('submit',e=>{e.preventDefault();const item={id:'c_'+Date.now(),topic:$('qTopic').value,text:$('qText').value.trim(),answers:[$('a0').value,$('a1').value,$('a2').value,$('a3').value],correct:+$('correct').value,tip:$('tip').value.trim(),source:$('source').value.trim(),base:false};const arr=custom();arr.push(item);save(LS_CUSTOM,arr);e.target.reset();renderManage();alert('Đã thêm câu hỏi!')});
    function deleteQuestion(id,isBase){if(!confirm('Bạn chắc chắn muốn xóa/ẩn câu hỏi này?'))return;if(isBase){const d=deleted();if(!d.includes(id))d.push(id);save(LS_DELETED,d)}else save(LS_CUSTOM,custom().filter(x=>x.id!==id));renderManage()}
    function restoreDeleted(){save(LS_DELETED,[]);renderManage()}
    function renderRank(){const r=load(LS_RANK,[]);$('rankList').innerHTML=r.length?r.map((x,i)=>`<div class="qitem"><div><b>#${i+1} ${x.pct}%</b><div class="muted">${x.topic} • ${x.score}/${x.total} • ${x.date}</div></div></div>`).join(''):'<p class="muted">Chưa có lượt chơi nào.</p>'}
    function toggleTheme(){document.body.classList.toggle('light');localStorage.setItem('cyber_theme',document.body.classList.contains('light')?'light':'dark')} if(localStorage.getItem('cyber_theme')==='light')document.body.classList.add('light');
    function openChat(){if(!$('chat').classList.contains('open'))toggleChat()} function toggleChat(){$('chat').classList.toggle('open')}
    function sendChat(){const input=$('chatInput');const text=input.value.trim();if(!text)return;addMsg(text,'user');input.value='';setTimeout(()=>addMsg(aiReply(text),'bot'),300)}
    function addMsg(t,type){const d=document.createElement('div');d.className='msg '+(type==='user'?'user':'');d.textContent=t;$('chatBody').appendChild(d);$('chatBody').scrollTop=$('chatBody').scrollHeight}
    function aiReply(t){t=t.toLowerCase();if(t.includes('phishing')||t.includes('lừa đảo'))return'Phishing là hình thức giả mạo email, tin nhắn hoặc website để lừa bạn nhập mật khẩu, OTP hoặc thông tin cá nhân. Cách tránh: kiểm tra tên miền, không bấm link lạ, không chia sẻ OTP.';if(t.includes('mật khẩu')||t.includes('password'))return'Mật khẩu mạnh nên dài, khó đoán, không dùng lại giữa các tài khoản. Bạn nên dùng trình quản lý mật khẩu và bật 2FA.';if(t.includes('2fa')||t.includes('otp')||t.includes('mfa'))return'2FA/MFA là lớp xác thực thứ hai ngoài mật khẩu. OTP tuyệt đối không chia sẻ cho bất kỳ ai, kể cả người tự xưng là hỗ trợ.';if(t.includes('ransomware')||t.includes('mã độc')||t.includes('virus'))return'Mã độc có thể đánh cắp hoặc mã hóa dữ liệu. Hãy cập nhật phần mềm, không tải crack, không mở file lạ và sao lưu dữ liệu theo nguyên tắc 3-2-1.';if(t.includes('wifi')||t.includes('wi-fi'))return'Khi dùng Wi‑Fi công cộng, hạn chế đăng nhập tài khoản quan trọng, ưu tiên HTTPS/VPN và tắt chia sẻ file trong mạng.';return'🔌 Chế độ ngoại tuyến: Mình trả lời dựa trên kho kiến thức trong trang. Bạn có thể hỏi về phishing, mật khẩu mạnh, 2FA, OTP, ransomware, mã độc, Wi‑Fi công cộng, quyền riêng tư hoặc sao lưu dữ liệu.'}
    function escapeHtml(s){return String(s).replace(/[&<>"]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]))}
    function matrix(){const c=$('matrix'),ctx=c.getContext('2d');let w,h,cols,drops;function resize(){w=c.width=innerWidth;h=c.height=innerHeight;cols=Math.floor(w/18);drops=Array(cols).fill(1)}resize();addEventListener('resize',resize);setInterval(()=>{ctx.fillStyle='rgba(7,17,31,.08)';ctx.fillRect(0,0,w,h);ctx.fillStyle='rgba(0,229,255,.6)';ctx.font='15px monospace';for(let i=0;i<drops.length;i++){const ch=Math.random()>.5?'0':'1';ctx.fillText(ch,i*18,drops[i]*18);if(drops[i]*18>h&&Math.random()>.975)drops[i]=0;drops[i]++}},55)} matrix(); renderTopics();
  </script>
</body>
</html>
